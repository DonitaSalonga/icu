# Copy to .env and fill in from Supabase project "ocm-main" → Project Settings → API.
# Only the publishable (anon) key belongs here. Never put a secret/service-role key in this file.
WXT_SUPABASE_URL=https://<project-ref>.supabase.co
WXT_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
# URL of the deployed (or local) dashboard; the extension opens it for admins (R1).
WXT_DASHBOARD_URL=http://localhost:5173
