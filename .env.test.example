# Copy to .env.test and fill in from Supabase project "ocm-test". Used ONLY by the test runner.
SUPABASE_TEST_URL=https://<test-project-ref>.supabase.co
SUPABASE_TEST_PUBLISHABLE_KEY=<publishable-or-anon-key>
# Secret/service-role key: creates and cleans up test users. Never ship it in an app bundle.
SUPABASE_TEST_SECRET_KEY=<secret-or-service-role-key>
TEST_USER_PASSWORD=<a-long-random-password>
